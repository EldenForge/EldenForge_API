# Database (Neon cloud - https://neon.tech)
# Format asyncpg avec ?ssl=require (NOT sslmode=require qui est psycopg2)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXX.eu-central-1.aws.neon.tech/DBNAME?ssl=require

# Test database (utilisée par pytest fixtures)
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXX.eu-central-1.aws.neon.tech/DBNAME_test?ssl=require

# JWT (en prod : générer avec `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
JWT_SECRET=dev-secret-change-me-via-env-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@eldenforge.local
RESEND_API_KEY=

# Front (pour liens dans emails)
FRONTEND_BASE_URL=http://localhost:5173

# Tokens TTL
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Lockout
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_SECONDS=900
